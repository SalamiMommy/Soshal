# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# frontend build output (Dioxus WASM)
dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# generated native folders
/android

# build credentials
service-account-key.json

# build artifacts (scripts are tracked, binaries are not)
builds/**/*.apk
builds/**/*.tar.gz
builds/**/*.AppImage
bundles/

# AI / agent tool configurations (personal — not project assets)
.claude/
.cursorignore
.cursorrules
.devin/
.opencode/
rununcompiled.sh

# Rust build artifacts
**/target/

# Node compile cache
tmp/

# Test coverage output
coverage/
lcov.info
*.profraw
*.profdata

# JDK symlink (machine-specific)
jlink

# orphaned wasm build artifacts
assets/*.wasm

# Build artifacts that must not be committed
*.apk
*.idsig

# Build artifacts
soshal_flutter/build/
target/
*.apk
*.idsig
__pycache__/
*.pyc
soshal_flutter/android/app/src/main/jniLibs/**/libi2pd.so
soshal_flutter/android/app/src/main/jniLibs/**/libfreenet.so
soshal_flutter/android/app/src/main/jniLibs/**/libsoshal_flutter_bridge.so

# Flutter / Dart tooling
**/.dart_tool/
soshal_flutter/.flutter-plugins
soshal_flutter/.flutter-plugins-dependencies
soshal_flutter/android/.gradle/
soshal_flutter/android/.kotlin/
soshal_flutter/linux/flutter/ephemeral/

# IDE / editor state (personal machine config)
.idea/
*.iml
.vscode/
.fleet/

# Personal notes / AI tooling vaults
.obsidian/

# Android signing material
**/*.keystore
**/key.properties

# App runtime data (local DBs, sessions, logs)
*.log
*.nsec

# Bundled daemon binaries — regenerated by builds/android/build.sh
soshal_flutter/android/app/src/main/assets/daemons/**/i2pd
soshal_flutter/android/app/src/main/assets/daemons/**/freenet
soshal_flutter/android/app/src/main/assets/daemons/**/rnsd

# Release artifacts — collected by builds/release/build.sh (keep the script)
builds/release/*
!builds/release/build.sh
