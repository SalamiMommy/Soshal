<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: system CAs only, no user-installed CAs to block MITM -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow cleartext for localhost/loopback only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    
    <!-- NOTE: Android <domain> matches hostname literals, NOT CIDR ranges.
         192.168.0.0 / 10.0.0.0 / 172.16.0.0 never match real device IPs
         like 192.168.1.50. P2P LAN uses QUIC with self-signed certs
         (HybridCertVerifier in quic.rs) — cleartext not needed.
         If cleartext LAN access is required in future, add per-host entries
         for discovered mDNS peers or use a custom TrustManager. -->
    
    <!-- Certificate pinning for critical endpoints (when deployed) -->
    <!-- Uncomment and add actual certificate pins for production endpoints -->
    <!--
    <domain-config>
        <domain includeSubdomains="true">api.soshal.app</domain>
        <pin-set>
            <pin digest="SHA-256">ADD_CERTIFICATE_PIN_HERE</pin>
            <pin digest="SHA-256">ADD_BACKUP_CERTIFICATE_PIN_HERE</pin>
        </pin-set>
    </domain-config>
    -->
    
    <!-- Debug overrides: user CAs allowed for dev/proxy tools (Charles, mitmproxy) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>