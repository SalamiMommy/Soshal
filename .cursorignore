# ==========================================
# .cursorignore 
# ==========================================

# 1. Version Control & OS Files
# AI doesn't need version history or system cache
.git/
.svn/
.DS_Store
Thumbs.db

# 2. Dependencies & Package Managers
# Massive directories that burn token cache
node_modules/
vendor/
bower_components/
.venv/
venv/
env/
__pycache__/

# 3. Build Outputs & Compiled Code
# Ignore anything the compiler generates
dist/
build/
out/
target/
bin/
obj/
.next/
.nuxt/
.svelte-kit/
*.class
*.o
*.pyc
*.exe
*.dll
*.so

# 4. Logs, Databases & Caches
# Extremely high token cost with zero coding context
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.sqlite
*.sqlite3
*.db
.cache/
.eslintcache
.stylelintcache

# 5. Minified Files & Large Data Dumps
# Unreadable to humans, expensive for AI
*.min.js
*.min.css
*.map
*.csv
*.tsv
*.dat

# 6. Media & Assets
# The AI cannot read these files anyway
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.webp
*.mp4
*.mp3
*.wav
*.pdf
*.zip
*.tar
*.gz

# 7. Environment Variables & Secrets
# Keep these hidden for security
.env
.env.local
.env.development
.env.test
.env.production
*.pem
