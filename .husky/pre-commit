#!/bin/bash
# Pre-commit: Format check + architecture compliance

set -e

echo "🔍 Running pre-commit checks..."

# 1. Format check
echo "📝 Checking code format..."
if ! cargo fmt --check; then
    echo "❌ Code format check failed. Run: cargo fmt"
    exit 1
fi
echo "✅ Code format OK"

# 2. Clippy lint
echo "🔎 Running clippy..."
if ! cargo clippy --workspace --all-targets --quiet -- -D warnings; then
    echo "❌ Clippy errors found"
    exit 1
fi
echo "✅ Clippy OK"

# 3. lib/ platform access guard (MethodChannel / Platform facts / banned plugins)
if ! bash scripts/guard-lib-platform.sh; then
    echo "❌ lib/ platform access guard failed"
    exit 1
fi
echo "✅ lib/ platform guard OK"

echo ""
echo "✅ Pre-commit checks passed!"