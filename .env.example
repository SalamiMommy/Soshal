# Soshal Environment Variables
# Copy this file to .env.local and fill in your values.

# Tauri updater signing (release builds only)
# Generate once: tauri signer generate -w ~/.tauri/soshal-updater.key
# Losing the private key permanently breaks update signing.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Android SDK (mobile builds)
ANDROID_HOME=$HOME/Android/Sdk
ANDROID_SDK_ROOT=$HOME/Android/Sdk
JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# Rust NDK toolchain dir for ring build scripts (must be on PATH)
# NDK_BIN=$ANDROID_HOME/ndk/27.1.12297006/toolchains/llvm/prebuilt/linux-x86_64/bin